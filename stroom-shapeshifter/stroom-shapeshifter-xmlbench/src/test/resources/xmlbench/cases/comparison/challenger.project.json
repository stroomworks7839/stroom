{
 "name": "comparison_challenger",
 "version": 4,
 "source": {
  "buffer_size": 100000,
  "ignore_errors": false,
  "encoding": "utf-8"
 },
 "templates": [
  {
   "id": "00000000-0000-0000-0000-000000000001",
   "name": "source",
   "match": "source",
   "body": [
    {
     "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><t>"
    },
    {
     "apply-templates": {
      "select": {
       "parts": [
        {
         "capture": {
          "group": 0
         }
        }
       ]
      },
      "mode": "doc"
     }
    },
    {
     "text": "</t>"
    }
   ]
  },
  {
   "id": "00000000-0000-0000-0000-000000000002",
   "name": "decl",
   "mode": "doc",
   "consume": true,
   "match": {
    "regex": {
     "pattern": "<\\?xml[^\\n]*\\n"
    }
   },
   "body": []
  },
  {
   "id": "00000000-0000-0000-0000-000000000003",
   "name": "open",
   "mode": "doc",
   "consume": true,
   "match": {
    "regex": {
     "pattern": "<cs>\\n"
    }
   },
   "body": []
  },
  {
   "id": "00000000-0000-0000-0000-000000000004",
   "name": "c",
   "mode": "doc",
   "match": {
    "regex": {
     "pattern": "  <c a=\"([^\"]*)\" b=\"([^\"]*)\" n=\"([^\"]*)\" w=\"([^\"]*)\"/>\\n"
    }
   },
   "body": [
    {
     "text": "<r><same>"
    },
    {
     "choose": {
      "when": [
       {
        "test": {
         "eq": {
          "left": {
           "ref": {
            "parts": [
             {
              "capture": {
               "group": 1
              }
             }
            ]
           }
          },
          "right": {
           "ref": {
            "parts": [
             {
              "capture": {
               "group": 2
              }
             }
            ]
           }
          }
         }
        },
        "body": [
         {
          "text": "true"
         }
        ]
       }
      ],
      "otherwise": [
       {
        "text": "false"
       }
      ]
     }
    },
    {
     "text": "</same><big>"
    },
    {
     "choose": {
      "when": [
       {
        "test": {
         "gt": {
          "left": {
           "ref": {
            "parts": [
             {
              "capture": {
               "group": 3
              }
             }
            ]
           },
           "as": "number"
          },
          "right": {
           "value": 100
          }
         }
        },
        "body": [
         {
          "text": "true"
         }
        ]
       }
      ],
      "otherwise": [
       {
        "text": "false"
       }
      ]
     }
    },
    {
     "text": "</big><big2>"
    },
    {
     "choose": {
      "when": [
       {
        "test": {
         "greater-than": {
          "select": {
           "parts": [
            {
             "capture": {
              "group": 3
             }
            }
           ]
          },
          "value": 100
         }
        },
        "body": [
         {
          "text": "true"
         }
        ]
       }
      ],
      "otherwise": [
       {
        "text": "false"
       }
      ]
     }
    },
    {
     "text": "</big2><ltm>"
    },
    {
     "choose": {
      "when": [
       {
        "test": {
         "lt": {
          "left": {
           "ref": {
            "parts": [
             {
              "capture": {
               "group": 4
              }
             }
            ]
           }
          },
          "right": {
           "value": "m"
          }
         }
        },
        "body": [
         {
          "text": "true"
         }
        ]
       }
      ],
      "otherwise": [
       {
        "text": "false"
       }
      ]
     }
    },
    {
     "text": "</ltm><mix>"
    },
    {
     "choose": {
      "when": [
       {
        "test": {
         "eq": {
          "left": {
           "ref": {
            "parts": [
             {
              "capture": {
               "group": 3
              }
             }
            ]
           },
           "as": "number"
          },
          "right": {
           "value": "150"
          }
         }
        },
        "body": [
         {
          "text": "true"
         }
        ]
       }
      ],
      "otherwise": [
       {
        "text": "false"
       }
      ]
     }
    },
    {
     "text": "</mix></r>"
    }
   ]
  },
  {
   "id": "00000000-0000-0000-0000-000000000005",
   "name": "close",
   "mode": "doc",
   "consume": true,
   "match": {
    "regex": {
     "pattern": "</cs>\\n"
    }
   },
   "body": []
  }
 ]
}