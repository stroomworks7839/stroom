{
 "name": "value_types_challenger",
 "version": 4,
 "source": {
  "buffer_size": 100000,
  "ignore_errors": false,
  "encoding": "utf-8"
 },
 "templates": [
  {
   "id": "00000000-0000-0000-0000-000000000001",
   "name": "source",
   "match": "source",
   "body": [
    {
     "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><vt>"
    },
    {
     "apply-templates": {
      "select": {
       "parts": [
        {
         "capture": {
          "group": 0
         }
        }
       ]
      },
      "mode": "doc"
     }
    },
    {
     "text": "</vt>"
    }
   ]
  },
  {
   "id": "00000000-0000-0000-0000-000000000002",
   "name": "decl",
   "mode": "doc",
   "consume": true,
   "match": {
    "regex": {
     "pattern": "<\\?xml[^\\n]*\\n"
    }
   },
   "body": []
  },
  {
   "id": "00000000-0000-0000-0000-000000000003",
   "name": "open",
   "mode": "doc",
   "consume": true,
   "match": {
    "regex": {
     "pattern": "<vals>\\n"
    }
   },
   "body": []
  },
  {
   "id": "00000000-0000-0000-0000-000000000004",
   "name": "val",
   "mode": "doc",
   "match": {
    "regex": {
     "pattern": "  <val x=\"([^\"]*)\"/>\\n"
    }
   },
   "body": [
    {
     "text": "<v>"
    },
    {
     "choose": {
      "when": [
       {
        "test": {
         "matches": {
          "select": {
           "parts": [
            {
             "capture": {
              "group": 1
             }
            }
           ]
          },
          "pattern": "[0-9]"
         }
        },
        "body": [
         {
          "text": "<n>"
         },
         {
          "number": {
           "select": [
            {
             "parts": [
              {
               "capture": {
                "group": 1
               }
              }
             ]
            }
           ]
          }
         },
         {
          "text": "</n><s>"
         },
         {
          "add": {
           "select": [
            {
             "parts": [
              {
               "capture": {
                "group": 1
               }
              }
             ]
            },
            {
             "parts": [
              {
               "text": "1"
              }
             ]
            }
           ]
          }
         },
         {
          "text": "</s><fl>"
         },
         {
          "floor": {
           "select": [
            {
             "parts": [
              {
               "capture": {
                "group": 1
               }
              }
             ]
            }
           ]
          }
         },
         {
          "text": "</fl>"
         }
        ]
       }
      ],
      "otherwise": [
       {
        "text": "<n/><s/><fl/>"
       }
      ]
     }
    },
    {
     "text": "</v>"
    }
   ]
  },
  {
   "id": "00000000-0000-0000-0000-000000000005",
   "name": "close",
   "mode": "doc",
   "consume": true,
   "match": {
    "regex": {
     "pattern": "</vals>\\n"
    }
   },
   "body": []
  }
 ]
}