{
 "name": "computed_names",
 "version": 4,
 "source": {
  "buffer_size": 100000,
  "ignore_errors": false,
  "encoding": "utf-8"
 },
 "templates": [
  {
   "id": "00000000-0000-0000-0000-000000000001",
   "name": "source",
   "match": "source",
   "body": [
    {
     "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><out><?generated by-case?><!--names are data-->"
    },
    {
     "apply-templates": {
      "select": {
       "parts": [
        {
         "capture": {
          "group": 0
         }
        }
       ]
      },
      "mode": "doc"
     }
    },
    {
     "text": "</out>"
    }
   ]
  },
  {
   "id": "00000000-0000-0000-0000-000000000002",
   "name": "decl",
   "mode": "doc",
   "consume": true,
   "match": {
    "regex": {
     "pattern": "<\\?xml[^\\n]*\\n"
    }
   },
   "body": []
  },
  {
   "id": "00000000-0000-0000-0000-000000000003",
   "name": "open",
   "mode": "doc",
   "consume": true,
   "match": {
    "regex": {
     "pattern": "<feed>\\n"
    }
   },
   "body": []
  },
  {
   "id": "00000000-0000-0000-0000-000000000004",
   "name": "item",
   "mode": "doc",
   "match": {
    "regex": {
     "pattern": "  <item type=\"([^\"]*)\" level=\"([^\"]*)\"><body>([^<]*)</body></item>\\n"
    }
   },
   "body": [
    {
     "value-of": {
      "parts": [
       {
        "text": "<"
       },
       {
        "capture": {
         "group": 1
        }
       },
       {
        "text": " sev-"
       },
       {
        "capture": {
         "group": 2
        }
       },
       {
        "text": "=\"yes\">"
       },
       {
        "capture": {
         "group": 3
        }
       },
       {
        "text": "</"
       },
       {
        "capture": {
         "group": 1
        }
       },
       {
        "text": ">"
       }
      ]
     }
    }
   ]
  },
  {
   "id": "00000000-0000-0000-0000-000000000005",
   "name": "raw",
   "mode": "doc",
   "match": {
    "regex": {
     "pattern": "  <raw>((?s).*?)</raw>\\n"
    }
   },
   "body": [
    {
     "value-of": {
      "parts": [
       {
        "capture": {
         "group": 1
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "00000000-0000-0000-0000-000000000006",
   "name": "close",
   "mode": "doc",
   "consume": true,
   "match": {
    "regex": {
     "pattern": "</feed>\\n"
    }
   },
   "body": []
  }
 ]
}