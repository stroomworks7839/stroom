{
 "name": "dates_challenger",
 "version": 4,
 "source": {
  "buffer_size": 100000,
  "ignore_errors": false,
  "encoding": "utf-8"
 },
 "templates": [
  {
   "id": "00000000-0000-0000-0000-000000000001",
   "name": "source",
   "match": "source",
   "body": [
    {
     "text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><t>"
    },
    {
     "apply-templates": {
      "select": {
       "parts": [
        {
         "capture": {
          "group": 0
         }
        }
       ]
      },
      "mode": "doc"
     }
    },
    {
     "text": "</t>"
    }
   ]
  },
  {
   "id": "00000000-0000-0000-0000-000000000002",
   "name": "decl",
   "mode": "doc",
   "consume": true,
   "match": {
    "regex": {
     "pattern": "<\\?xml[^\\n]*\\n"
    }
   },
   "body": []
  },
  {
   "id": "00000000-0000-0000-0000-000000000003",
   "name": "open",
   "mode": "doc",
   "consume": true,
   "match": {
    "regex": {
     "pattern": "<log>\\n"
    }
   },
   "body": []
  },
  {
   "id": "00000000-0000-0000-0000-000000000004",
   "name": "e",
   "mode": "doc",
   "match": {
    "regex": {
     "pattern": "  <e ts=\"([^\"]*)\" sys=\"([^\"]*)\" received=\"([^\"]*)\" ms=\"([^\"]*)\"/>\\n"
    }
   },
   "body": [
    {
     "parse-date": {
      "select": [
       {
        "parts": [
         {
          "capture": {
           "group": 1
          }
         }
        ]
       }
      ],
      "pattern": "iso",
      "name": "t_ts"
     }
    },
    {
     "parse-date": {
      "select": [
       {
        "parts": [
         {
          "capture": {
           "group": 3
          }
         }
        ]
       }
      ],
      "pattern": "iso",
      "name": "t_recv"
     }
    },
    {
     "text": "<o><utc>"
    },
    {
     "format-date": {
      "select": [
       {
        "parts": [
         {
          "capture": {
           "var_id": "t_ts",
           "group": 0
          }
         }
        ]
       }
      ],
      "pattern": "uuuu-MM-dd'T'HH:mm:ss'Z'",
      "timezone": "UTC"
     }
    },
    {
     "text": "</utc><sys>"
    },
    {
     "parse-date": {
      "select": [
       {
        "parts": [
         {
          "capture": {
           "group": 2
          }
         }
        ]
       }
      ],
      "pattern": "MMM d HH:mm:ss",
      "timezone": "UTC",
      "reference": {
       "parts": [
        {
         "capture": {
          "group": 3
         }
        }
       ]
      },
      "name": "t_sys"
     }
    },
    {
     "format-date": {
      "select": [
       {
        "parts": [
         {
          "capture": {
           "var_id": "t_sys",
           "group": 0
          }
         }
        ]
       }
      ],
      "pattern": "uuuu-MM-dd'T'HH:mm:ss'Z'",
      "timezone": "UTC"
     }
    },
    {
     "text": "</sys><ep>"
    },
    {
     "parse-date": {
      "select": [
       {
        "parts": [
         {
          "capture": {
           "group": 4
          }
         }
        ]
       }
      ],
      "pattern": "epoch-millis",
      "name": "t_ep"
     }
    },
    {
     "format-date": {
      "select": [
       {
        "parts": [
         {
          "capture": {
           "var_id": "t_ep",
           "group": 0
          }
         }
        ]
       }
      ],
      "pattern": "uuuu-MM-dd'T'HH:mm:ss'Z'",
      "timezone": "UTC"
     }
    },
    {
     "text": "</ep><dur>"
    },
    {
     "subtract": {
      "select": [
       {
        "parts": [
         {
          "capture": {
           "var_id": "t_recv",
           "group": 0
          }
         }
        ]
       },
       {
        "parts": [
         {
          "capture": {
           "var_id": "t_ts",
           "group": 0
          }
         }
        ]
       }
      ]
     }
    },
    {
     "text": "</dur><rt>"
    },
    {
     "format-date": {
      "select": [
       {
        "parts": [
         {
          "capture": {
           "var_id": "t_ts",
           "group": 0
          }
         }
        ]
       }
      ],
      "pattern": "uuuu-MM-dd'T'HH:mm:ssxxx"
     }
    },
    {
     "text": "</rt></o>"
    }
   ]
  },
  {
   "id": "00000000-0000-0000-0000-000000000005",
   "name": "close",
   "mode": "doc",
   "consume": true,
   "match": {
    "regex": {
     "pattern": "</log>\\n"
    }
   },
   "body": []
  }
 ]
}