test anchored/greedy
regex (abc)+
haystack abcabcabc
anchored true
matches 0-9,6-9

test anchored/nongreedy
regex (abc)+?
haystack abcabcabc
anchored true
matches 0-3,0-3;3-6,3-6;6-9,6-9

test anchored/word-boundary-unicode-01
regex \\b\\w+\\b
haystack βββ☃
anchored true
matches 0-6

test anchored/word-boundary-nounicode-01
regex (?-u)\\b\\w+\\b
haystack abcβ
anchored true
matches 0-3

test anchored/no-match-at-start
regex .c
haystack abc
anchored true
matches -

test anchored/no-match-at-start-bounds
regex .c
haystack aabc
anchored true
bounds 1 4
matches -

test anchored/no-match-at-start-reverse-inner
regex .c[a-z]
haystack abcz
anchored true
matches -

test anchored/no-match-at-start-reverse-inner-bounds
regex .c[a-z]
haystack aabcz
anchored true
bounds 1 5
matches -

test anchored/no-match-at-start-reverse-anchored
regex .c[a-z]$
haystack abcz
anchored true
matches -

test anchored/no-match-at-start-reverse-anchored-bounds
regex .c[a-z]$
haystack aabcz
anchored true
bounds 1 5
matches -
