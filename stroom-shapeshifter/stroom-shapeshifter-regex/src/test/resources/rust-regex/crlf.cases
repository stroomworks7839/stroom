test crlf/basic
regex (?mR)^[a-z]+$
haystack abc\r\ndef\r\nxyz
matches 0-3;5-8;10-13

test crlf/start-end-non-empty
regex (?mR)^$
haystack abc\r\ndef\r\nxyz
matches -

test crlf/start-end-empty
regex (?mR)^$
haystack 
matches 0-0

test crlf/start-end-before-after
regex (?mR)^$
haystack \r\n
matches 0-0;2-2

test crlf/start-no-split
regex (?mR)^
haystack abc\r\ndef\r\nxyz
matches 0-0;5-5;10-10

test crlf/start-no-split-adjacent
regex (?mR)^
haystack \r\n\r\n\r\n
matches 0-0;2-2;4-4;6-6

test crlf/start-no-split-adjacent-cr
regex (?mR)^
haystack \r\r\r
matches 0-0;1-1;2-2;3-3

test crlf/start-no-split-adjacent-lf
regex (?mR)^
haystack \n\n\n
matches 0-0;1-1;2-2;3-3

test crlf/end-no-split
regex (?mR)$
haystack abc\r\ndef\r\nxyz
matches 3-3;8-8;13-13

test crlf/end-no-split-adjacent
regex (?mR)$
haystack \r\n\r\n\r\n
matches 0-0;2-2;4-4;6-6

test crlf/end-no-split-adjacent-cr
regex (?mR)$
haystack \r\r\r
matches 0-0;1-1;2-2;3-3

test crlf/end-no-split-adjacent-lf
regex (?mR)$
haystack \n\n\n
matches 0-0;1-1;2-2;3-3

test crlf/dot-no-crlf
regex (?R).
haystack \r\n\r\n\r\n
matches -

test crlf/onepass-wrong-crlf-with-capture
regex (?Rm:().$)
haystack ZZ\r
matches 1-2,1-1

test crlf/onepass-wrong-crlf-anchored
regex (?Rm:.$)
haystack ZZ\r
anchored true
bounds 1 3
matches 1-2
