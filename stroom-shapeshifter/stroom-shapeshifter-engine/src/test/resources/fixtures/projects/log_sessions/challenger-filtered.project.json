{
 "name": "log_sessions_filtered",
 "version": 5,
 "source": {
  "buffer_size": 20000,
  "ignore_errors": false,
  "encoding": "utf-8"
 },
 "templates": [
  {
   "id": "00000000-0000-0000-0000-000000000001",
   "name": "source",
   "declarations": [
    {
     "name": "bytes",
     "type": "list"
    },
    {
     "name": "host",
     "type": "list"
    },
    {
     "name": "kb",
     "type": "scalar"
    },
    {
     "name": "path",
     "type": "list"
    },
    {
     "name": "status",
     "type": "list"
    },
    {
     "name": "when",
     "type": "scalar"
    },
    {
     "name": "tag_parts",
     "type": "list"
    },
    {
     "name": "tags",
     "type": "list"
    },
    {
     "name": "ts",
     "type": "list"
    },
    {
     "name": "uniq_hosts",
     "type": "set"
    },
    {
     "name": "uniq_users",
     "type": "set"
    },
    {
     "name": "user",
     "type": "list"
    },
    {
     "name": "f_user",
     "type": "list"
    },
    {
     "name": "f_path",
     "type": "list"
    }
   ],
   "match": "source",
   "body": [
    {
     "text": "<summary>"
    },
    {
     "apply-templates": {
      "select": {
       "parts": [
        {
         "capture": {
          "group": 0
         }
        }
       ]
      },
      "mode": "log"
     }
    },
    {
     "text": "\n  <totals requests=\""
    },
    {
     "value-of": {
      "parts": [
       {
        "size": {
         "of": "host"
        }
       }
      ]
     }
    },
    {
     "text": "\" bytes=\""
    },
    {
     "value-of": {
      "parts": [
       {
        "sum": {
         "of": "bytes"
        }
       }
      ]
     }
    },
    {
     "text": "\" largest=\""
    },
    {
     "value-of": {
      "parts": [
       {
        "max": {
         "of": "bytes",
         "as": "number"
        }
       }
      ]
     }
    },
    {
     "text": "\" hosts=\""
    },
    {
     "clear": {
      "name": "uniq_hosts"
     }
    },
    {
     "for-each": {
      "select": "host",
      "as": "h",
      "body": [
       {
        "put": {
         "name": "uniq_hosts",
         "select": {
          "parts": [
           {
            "capture": {
             "var_id": "h",
             "group": 0
            }
           }
          ]
         }
        }
       }
      ]
     }
    },
    {
     "value-of": {
      "parts": [
       {
        "size": {
         "of": "uniq_hosts"
        }
       }
      ]
     }
    },
    {
     "text": "\"/>\n  <users>"
    },
    {
     "clear": {
      "name": "uniq_users"
     }
    },
    {
     "for-each": {
      "select": "user",
      "as": "u",
      "body": [
       {
        "put": {
         "name": "uniq_users",
         "select": {
          "parts": [
           {
            "capture": {
             "var_id": "u",
             "group": 0
            }
           }
          ]
         }
        }
       }
      ]
     }
    },
    {
     "for-each": {
      "select": "uniq_users",
      "as": "u",
      "sort": [
       {
        "by": {
         "parts": [
          {
           "capture": {
            "var_id": "u",
            "group": 0
           }
          }
         ]
        }
       }
      ],
      "body": [
       {
        "text": "<u>"
       },
       {
        "value-of": {
         "parts": [
          {
           "capture": {
            "var_id": "u",
            "group": 0
           }
          }
         ]
        }
       },
       {
        "text": "</u>"
       }
      ]
     }
    },
    {
     "text": "</users>\n  <hosts>"
    },
    {
     "for-each-group": {
      "select": "host",
      "body": [
       {
        "text": "\n    <host name=\""
       },
       {
        "value-of": {
         "parts": [
          {
           "function": {
            "name": "groupKey"
           }
          }
         ]
        }
       },
       {
        "text": "\" requests=\""
       },
       {
        "value-of": {
         "parts": [
          {
           "function": {
            "name": "groupSize"
           }
          }
         ]
        }
       },
       {
        "text": "\">"
       },
       {
        "for-each": {
         "select": "group()",
         "as": "i",
         "sort": [
          {
           "by": {
            "parts": [
             {
              "capture": {
               "var_id": "bytes",
               "group": 0,
               "match_index": {
                "var_ref": "i"
               }
              }
             }
            ]
           },
           "as": "number",
           "order": "descending"
          }
         ],
         "body": [
          {
           "parse-date": {
            "select": [
             {
              "parts": [
               {
                "capture": {
                 "var_id": "ts",
                 "group": 0,
                 "match_index": {
                  "var_ref": "i"
                 }
                }
               }
              ]
             }
            ],
            "pattern": "iso",
            "name": "when"
           }
          },
          {
           "text": "\n      <req at=\""
          },
          {
           "format-date": {
            "select": [
             {
              "parts": [
               {
                "capture": {
                 "var_id": "when",
                 "group": 0
                }
               }
              ]
             }
            ],
            "pattern": "HH:mm:ss",
            "timezone": "UTC"
           }
          },
          {
           "text": "\" user=\""
          },
          {
           "value-of": {
            "parts": [
             {
              "capture": {
               "var_id": "user",
               "group": 0,
               "match_index": {
                "var_ref": "i"
               }
              }
             }
            ]
           }
          },
          {
           "text": "\" leaf=\""
          },
          {
           "substring-after": {
            "select": [
             {
              "parts": [
               {
                "capture": {
                 "var_id": "path",
                 "group": 0,
                 "match_index": {
                  "var_ref": "i"
                 }
                }
               }
              ]
             }
            ],
            "marker": "/a/"
           }
          },
          {
           "text": "\" kb=\""
          },
          {
           "divide": {
            "select": [
             {
              "parts": [
               {
                "capture": {
                 "var_id": "bytes",
                 "group": 0,
                 "match_index": {
                  "var_ref": "i"
                 }
                }
               }
              ]
             },
             {
              "parts": [
               {
                "text": "1024"
               }
              ]
             }
            ],
            "name": "kb"
           }
          },
          {
           "round": {
            "select": [
             {
              "parts": [
               {
                "capture": {
                 "var_id": "kb",
                 "group": 0
                }
               }
              ]
             }
            ]
           }
          },
          {
           "text": "\" large=\""
          },
          {
           "choose": {
            "when": [
             {
              "test": {
               "gt": {
                "left": {
                 "ref": {
                  "parts": [
                   {
                    "capture": {
                     "var_id": "bytes",
                     "group": 0,
                     "match_index": {
                      "var_ref": "i"
                     }
                    }
                   }
                  ]
                 },
                 "as": "number"
                },
                "right": {
                 "value": 10000
                }
               }
              },
              "body": [
               {
                "text": "yes"
               }
              ]
             }
            ],
            "otherwise": [
             {
              "text": "no"
             }
            ]
           }
          },
          {
           "text": "\">"
          },
          {
           "tokenize": {
            "select": [
             {
              "parts": [
               {
                "capture": {
                 "var_id": "tags",
                 "group": 0,
                 "match_index": {
                  "var_ref": "i"
                 }
                }
               }
              ]
             }
            ],
            "delimiter": ",",
            "name": "tag_parts"
           }
          },
          {
           "for-each": {
            "select": "tag_parts",
            "as": "tg",
            "body": [
             {
              "text": "<tag>"
             },
             {
              "value-of": {
               "parts": [
                {
                 "capture": {
                  "var_id": "tg",
                  "group": 0
                 }
                }
               ]
              }
             },
             {
              "text": "</tag>"
             }
            ]
           }
          },
          {
           "text": "</req>"
          }
         ]
        }
       },
       {
        "text": "\n    </host>"
       }
      ]
     }
    },
    {
     "text": "\n  </hosts>\n  <failures status=\"401\">"
    },
    {
     "for-each": {
      "select": "f_user",
      "as": "fu",
      "body": [
       {
        "text": "\n    <f user=\""
       },
       {
        "value-of": {
         "parts": [
          {
           "capture": {
            "var_id": "fu",
            "group": 0
           }
          }
         ]
        }
       },
       {
        "text": "\" path=\""
       },
       {
        "value-of": {
         "parts": [
          {
           "capture": {
            "var_id": "f_path",
            "group": 0,
            "match_index": {
             "function": "index"
            }
           }
          }
         ]
        }
       },
       {
        "text": "\"/>"
       }
      ]
     }
    },
    {
     "text": "\n  </failures>\n</summary>\n"
    }
   ]
  },
  {
   "id": "00000000-0000-0000-0000-000000000002",
   "name": "request",
   "mode": "log",
   "match": {
    "regex": {
     "pattern": "([^|]*)\\|([^|]*)\\|([^|]*)\\|([^|]*)\\|([^|]*)\\|([^|]*)\\|([^\\n]*)\\n"
    }
   },
   "captures": [
    {
     "name": "ts",
     "select": {
      "group": 1
     }
    },
    {
     "name": "host",
     "select": {
      "group": 2
     }
    },
    {
     "name": "user",
     "select": {
      "group": 3
     }
    },
    {
     "name": "bytes",
     "select": {
      "group": 4
     }
    },
    {
     "name": "path",
     "select": {
      "group": 5
     }
    },
    {
     "name": "status",
     "select": {
      "group": 6
     }
    },
    {
     "name": "tags",
     "select": {
      "group": 7
     }
    }
   ],
   "body": [
    {
     "if": {
      "test": {
       "eq": {
        "left": {
         "ref": {
          "parts": [
           {
            "capture": {
             "group": 6
            }
           }
          ]
         },
         "as": "string"
        },
        "right": {
         "value": "401",
         "as": "string"
        }
       }
      },
      "then": [
       {
        "append": {
         "name": "f_user",
         "select": {
          "parts": [
           {
            "capture": {
             "group": 3
            }
           }
          ]
         }
        }
       },
       {
        "append": {
         "name": "f_path",
         "select": {
          "parts": [
           {
            "capture": {
             "group": 5
            }
           }
          ]
         }
        }
       }
      ]
     }
    }
   ]
  }
 ]
}