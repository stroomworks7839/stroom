{
 "name": "library_parts",
 "version": 1,
 "source": {
  "buffer_size": 20000,
  "ignore_errors": true,
  "encoding": "auto"
 },
 "templates": [
  {
   "id": "00000000-0000-0000-0000-0000000000d0",
   "name": "document",
   "match": "source",
   "match_limits": {
    "min_match": 0,
    "max_match": -1
   },
   "body": [
    {
     "apply-templates": {
      "select": {
       "parts": [
        {
         "capture": {
          "group": 0
         }
        }
       ]
      },
      "max_depth": 64
     }
    }
   ]
  },
  {
   "id": "00000000-0000-0000-0000-000000000001",
   "name": "line",
   "match": {
    "pattern": {
     "sequence": [
      {
       "ref": "TIMESTAMP",
       "label": "time"
      },
      {
       "tag": " host="
      },
      {
       "ref": "WORD",
       "label": "host"
      },
      {
       "tag": " severity="
      },
      {
       "take_while": "\\p{L}",
       "label": "severity"
      },
      {
       "tag": " msg="
      },
      {
       "repeat": {
        "take_while": ".",
        "max": 1
       },
       "min": 0,
       "greedy": false,
       "label": "msg"
      },
      {
       "ref": "FIELD"
      },
      {
       "take_while": "\\p{Nd}",
       "label": "pid"
      },
      {
       "take_while": "[^\\n]",
       "min": 0
      },
      {
       "tag": "\n"
      }
     ]
    }
   },
   "match_limits": {
    "min_match": 0,
    "max_match": -1
   },
   "body": [
    {
     "text": "<event time=\""
    },
    {
     "value-of": {
      "parts": [
       {
        "capture": {
         "label": "time"
        }
       }
      ]
     }
    },
    {
     "text": "\" host=\""
    },
    {
     "value-of": {
      "parts": [
       {
        "capture": {
         "label": "host"
        }
       }
      ]
     }
    },
    {
     "text": "\" severity=\""
    },
    {
     "value-of": {
      "parts": [
       {
        "capture": {
         "label": "severity"
        }
       }
      ]
     }
    },
    {
     "text": "\" pid=\""
    },
    {
     "value-of": {
      "parts": [
       {
        "capture": {
         "label": "pid"
        }
       }
      ]
     }
    },
    {
     "text": "\">"
    },
    {
     "value-of": {
      "parts": [
       {
        "capture": {
         "label": "msg"
        }
       }
      ]
     }
    },
    {
     "text": "</event>\n"
    }
   ]
  }
 ],
 "patterns": {
  "TIMESTAMP": {
   "sequence": [
    {
     "take_while": "[0-9]",
     "min": 4,
     "max": 4
    },
    {
     "tag": "-"
    },
    {
     "take_while": "[0-9]",
     "min": 2,
     "max": 2
    },
    {
     "tag": "-"
    },
    {
     "take_while": "[0-9]",
     "min": 2,
     "max": 2
    },
    {
     "tag": "T"
    },
    {
     "take_while": "[0-9]",
     "min": 2,
     "max": 2
    },
    {
     "tag": ":"
    },
    {
     "take_while": "[0-9]",
     "min": 2,
     "max": 2
    },
    {
     "tag": ":"
    },
    {
     "take_while": "[0-9]",
     "min": 2,
     "max": 2
    },
    {
     "tag": "Z"
    }
   ]
  },
  "WORD": {
   "take_while": "\\S"
  },
  "FIELD": {
   "sequence": [
    {
     "tag": " "
    },
    {
     "ref": "KEY"
    },
    {
     "tag": "="
    }
   ]
  },
  "KEY": {
   "take_while": "[a-z]"
  }
 }
}
