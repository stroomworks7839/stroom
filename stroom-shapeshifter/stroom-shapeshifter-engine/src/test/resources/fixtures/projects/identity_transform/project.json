{
  "name": "identity_transform",
  "version": 3,
  "source": {
    "buffer_size": 20000,
    "ignore_errors": true,
    "encoding": "auto"
  },
  "templates": [
    {
      "id": "60a27d6e-31fb-4537-b546-9fade094b619",
      "name": "line_split",
      "match": {
        "delimiter": {
          "delimiter": "\n"
        }
      },
      "match_limits": {
        "min_match": 0,
        "max_match": -1
      },
      "body": [
        {
          "apply-templates": {
            "select": {
              "parts": [
                {
                  "Store": {
                    "var_id": null,
                    "group": 0,
                    "match_index": null
                  }
                }
              ]
            },
            "mode": "elements",
            "max_depth": 64
          }
        },
        {
          "value-of": {
            "parts": [
              {
