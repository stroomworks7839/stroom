{
 "name": "progressive_len_records",
 "version": 1,
 "source": {
  "buffer_size": 1000000,
  "ignore_errors": true,
  "encoding": "UTF-8"
 },
 "templates": [
  {
   "id": "e97f0eba-5e1a-587e-a22e-a3d761377ea6",
   "name": "root",
   "match": {
    "parts": [
     {
      "read": {
       "as": "varint",
       "label": "len"
      }
     },
     {
      "take": {
       "length": {
        "label": "len"
       },
       "label": "name"
      }
     }
    ]
   },
   "match_limits": {
    "min_match": 0,
    "max_match": -1
   },
   "body": [
    {
     "value-of": {
      "parts": [
       {
        "text": "<rec name=\""
       },
       {
        "capture": {
         "label": "name"
        }
       },
       {
        "text": "\"/>\n"
       }
      ]
     }
    }
   ],
   "encoding": "raw"
  }
 ]
}
