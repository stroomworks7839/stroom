{
 "name": "event_logging_structured",
 "version": 5,
 "source": {
  "buffer_size": 20000,
  "ignore_errors": false,
  "encoding": "utf-8"
 },
 "templates": [
  {
   "id": "00000000-0000-0000-0000-000000000001",
   "name": "source",
   "match": "source",
   "body": [
    {
     "text": "<?xml version=\"1.1\" encoding=\"UTF-8\"?>\n"
    },
    {
     "element": {
      "name": "Events",
      "namespace": "event-logging:3",
      "body": [
       {
        "namespace": {
         "prefix": "xsi",
         "uri": "http://www.w3.org/2001/XMLSchema-instance"
        }
       },
       {
        "attribute": {
         "name": "xsi:schemaLocation",
         "body": [
          {
           "text": "event-logging:3 file://event-logging-v3.4.2.xsd"
          }
         ]
        }
       },
       {
        "attribute": {
         "name": "Version",
         "body": [
          {
           "text": "3.4.2"
          }
         ]
        }
       },
       {
        "apply-templates": {
         "select": {
          "parts": [
           {
            "capture": {
             "group": 0
            }
           }
          ]
         },
         "mode": "lines"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "00000000-0000-0000-0000-000000000002",
   "name": "event",
   "mode": "lines",
   "match": {
    "regex": {
     "pattern": "(\\S+) (\\w+) (\\S+) (\\S+) \"([^\"]*)\"(?: (\\d+))?\\n"
    }
   },
   "body": [
    {
     "element": {
      "name": "Event",
      "body": [
       {
        "element": {
         "name": "EventTime",
         "body": [
          {
           "element": {
            "name": "TimeCreated",
            "body": [
             {
              "value-of": {
               "parts": [
                {
                 "capture": {
                  "group": 1
                 }
                }
               ]
              }
             }
            ]
           }
          }
         ]
        }
       },
       {
        "element": {
         "name": "EventSource",
         "body": [
          {
           "element": {
            "name": "User",
            "body": [
             {
              "element": {
               "name": "Id",
               "body": [
                {
                 "value-of": {
                  "parts": [
                   {
                    "capture": {
                     "group": 3
                    }
                   }
                  ]
                 }
                }
               ]
              }
             }
            ]
           }
          },
          {
           "element": {
            "name": "Client",
            "body": [
             {
              "element": {
               "name": "IPAddress",
               "body": [
                {
                 "value-of": {
                  "parts": [
                   {
                    "capture": {
                     "group": 4
                    }
                   }
                  ]
                 }
                }
               ]
              }
             }
            ]
           }
          }
         ]
        }
       },
       {
        "element": {
         "name": "EventDetail",
         "body": [
          {
           "if": {
            "test": {
             "exists": {
              "select": {
               "parts": [
                {
                 "capture": {
                  "group": 6
                 }
                }
               ]
              }
             }
            },
            "then": [
             {
              "attribute": {
               "name": "Attempts",
               "body": [
                {
                 "value-of": {
                  "parts": [
                   {
                    "capture": {
                     "group": 6
                    }
                   }
                  ]
                 }
                }
               ]
              }
             }
            ]
           }
          },
          {
           "attribute": {
            "name": "Action",
            "body": [
             {
              "upper-case": {
               "select": [
                {
                 "parts": [
                  {
                   "capture": {
                    "group": 2
                   }
                  }
                 ]
                }
               ]
              }
             }
            ]
           }
          },
          {
           "attribute": {
            "name": "Agent",
            "body": [
             {
              "value-of": {
               "parts": [
                {
                 "capture": {
                  "group": 5
                 }
                }
               ]
              }
             }
            ]
           }
          },
          {
           "element": {
            "name": "Description",
            "body": [
             {
              "value-of": {
               "parts": [
                {
                 "capture": {
                  "group": 2
                 }
                }
               ]
              }
             },
             {
              "text": " by "
             },
             {
              "value-of": {
               "parts": [
                {
                 "capture": {
                  "group": 3
                 }
                }
               ]
              }
             }
            ]
           }
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "00000000-0000-0000-0000-000000000003",
   "name": "junk",
   "mode": "lines",
   "consume": true,
   "match": {
    "regex": {
     "pattern": "[^\\n]*\\n?"
    }
   },
   "body": [
    {
     "emit-error": {
      "severity": "warning",
      "message": {
       "parts": [
        {
         "text": "unrecognised line: "
        },
        {
         "capture": {
          "group": 0
         }
        }
       ]
      }
     }
    }
   ]
  }
 ]
}