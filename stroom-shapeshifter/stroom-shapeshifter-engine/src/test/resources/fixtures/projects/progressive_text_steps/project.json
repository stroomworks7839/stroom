{
  "name": "progressive_text_steps",
  "version": 1,
  "source": {
    "buffer_size": 20000,
    "ignore_errors": true,
    "encoding": "auto"
  },
  "templates": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "line",
      "match": {
        "progressive": [
          {
            "Regex": {
              "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z"
            }
          },
          {
            "Tag": " host="
          },
          {
            "TakeWhile": "NonWhitespace"
          },
          {
            "Tag": " severity="
          },
          {
            "TakeWhile": "Alphabetic"
          },
          {
            "Tag": " msg="
          },
          {
            "TakeUntil": {
              "pattern": " pid=",
              "inclusive": false
            }
          },
          {
            "Tag": " pid="
          },
          {
            "TakeWhile": "Numeric"
          },
          {
            "TakeUntil": {
              "pattern": "\n",
              "inclusive": true
            }
          }
        ]
      },
      "match_limits": {
        "min_match": 0,
        "max_match": -1
      },
      "body": [
        {
          "value-of": {
            "parts": [
              {
                "text": "<event time=\""
              },
              {
                "capture": {
                  "var_id": null,
                  "group": 1,
                  "match_index": null
                }
              },
              {
                "text": "\" host=\""
              },
              {
                "capture": {
                  "var_id": null,
                  "group": 3,
                  "match_index": null
                }
              },
              {
                "text": "\" severity=\""
              },
              {
                "capture": {
                  "var_id": null,
                  "group": 5,
                  "match_index": null
                }
              },
              {
                "text": "\" pid=\""
              },
              {
                "capture": {
                  "var_id": null,
                  "group": 9,
                  "match_index": null
                }
              },
              {
                "text": "\">"
              },
              {
                "capture": {
                  "var_id": null,
                  "group": 7,
                  "match_index": null
                }
              },
              {
                "text": "</event>\n"
              }
            ]
          }
        }
      ]
    }
  ]
}
