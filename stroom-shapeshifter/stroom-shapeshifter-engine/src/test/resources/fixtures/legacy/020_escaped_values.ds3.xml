<?xml version="1.0" encoding="UTF-8"?>
<!--
  Design 21 phase 0. Every character the attribute escaping table names, in a referenced name
  and a referenced value, with a carriage return on the second line. The golden is Java Stroom's
  own DS3 output, produced through TestDS3's harness like every other legacy golden.
-->
<dataSplitter
        xmlns="data-splitter:3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="data-splitter:3 file://data-splitter-v3.0.xsd"
        version="3.0">

  <split delimiter="\n">
    <group value="$1">
      <regex pattern="^([^=]+)=([^=]*)">
        <data name="$1" value="$2" />
      </regex>
    </group>
  </split>
</dataSplitter>
