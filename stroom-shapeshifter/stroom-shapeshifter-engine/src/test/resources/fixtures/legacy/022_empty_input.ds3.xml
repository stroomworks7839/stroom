<?xml version="1.0" encoding="UTF-8"?>
<!--
  Design 21 phase 0 audit. An input that yields no record at all, to pin how Stroom serialises an
  empty root — paired or self-closed — which no vendored golden reaches and the census had
  asserted from memory. Golden from Java Stroom's DS3.
-->
<dataSplitter
        xmlns="data-splitter:3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="data-splitter:3 file://data-splitter-v3.0.xsd"
        version="3.0">

  <split delimiter="\n">
    <group value="$1">
      <regex pattern="^([^=]+)=([^=]*)">
        <data name="$1" value="$2" />
      </regex>
    </group>
  </split>
</dataSplitter>
