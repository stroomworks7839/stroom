{
  "name": "019_single_line_split",
  "version": 3,
  "source": {
    "buffer_size": 20000,
    "ignore_errors": false,
    "encoding": "auto"
  },
  "templates": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "source",
      "match": "source",
      "body": [
        {
          "value-of": {
            "parts": [
              {
                "text": "<?xml version=\"1.1\" encoding=\"UTF-8\"?>\n<records xmlns=\"records:2\"\n         xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n         xsi:schemaLocation=\"records:2 file://records-v2.0.xsd\"\n         version=\"2.0\">"
              }
            ]
          }
        },
        {
          "apply-templates": {
            "select": {
              "parts": [
                {
                  "capture": {
                    "group": 0
                  }
                }
              ]
            },
            "mode": "root"
          }
        },
        {
          "value-of": {
            "parts": [
              {
                "text": "\n</records>\n"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "name": "header_record",
      "mode": "root",
      "match": {
        "delimiter": {
          "delimiter": "|"
        }
      },
      "match_limits": {
        "max_match": 1
      },
      "body": [
        {
          "apply-templates": {
            "select": {
              "parts": [
                {
                  "capture": {
                    "group": 1
                  }
                }
              ]
            },
            "mode": "header_columns"
          }
        }
      ]
    },
    {
      "id": "00000000-0000-0000-0000-000000000003",
      "name": "header_column",
      "mode": "header_columns",
      "match": {
        "delimiter": {
          "delimiter": ",",
          "container_start": "\"",
          "container_end": "\""
        }
      },
      "captures": [
        {
          "name": "heading",
          "select": {
            "group": 1
          }
        }
      ],
      "body": []
    },
    {
      "id": "00000000-0000-0000-0000-000000000004",
      "name": "data_record",
      "mode": "root",
      "match": {
        "delimiter": {
          "delimiter": "|"
        }
      },
      "body": [
        {
          "variable": {
            "name": "__record_body__",
            "body": [
              {
                "apply-templates": {
                  "select": {
                    "parts": [
                      {
                        "capture": {
                          "group": 1
                        }
                      }
                    ]
                  },
                  "mode": "data_columns"
                }
              }
            ]
          }
        },
        {
          "if": {
            "test": {
              "exists": {
                "select": {
                  "parts": [
                    {
                      "capture": {
                        "var_id": "__record_body__",
                        "group": 0,
                        "match_index": {
                          "index": 0,
                          "is_offset": true
                        }
                      }
                    }
                  ]
                }
              }
            },
            "then": [
              {
                "value-of": {
                  "parts": [
                    {
                      "text": "\n   <record>"
                    }
                  ]
                }
              },
              {
                "value-of": {
                  "parts": [
                    {
                      "capture": {
                        "var_id": "__record_body__",
                        "group": 0,
                        "match_index": {
                          "index": 0,
                          "is_offset": true
                        }
                      }
                    }
                  ]
                }
              },
              {
                "value-of": {
                  "parts": [
                    {
                      "text": "\n   </record>"
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "00000000-0000-0000-0000-000000000005",
      "name": "data_column",
      "mode": "data_columns",
      "match": {
        "delimiter": {
          "delimiter": ",",
          "container_start": "\"",
          "container_end": "\""
        }
      },
      "body": [
        {
          "value-of": {
            "parts": [
              {
                "text": "\n      <data name=\""
              },
              {
                "capture": {
                  "var_id": "heading",
                  "group": 0,
                  "match_index": {
                    "var_ref": "__match_count"
                  }
                }
              },
              {
                "text": "\" value=\""
              },
              {
                "capture": {
                  "group": 1
                }
              },
              {
                "text": "\"/>"
              }
            ]
          }
        }
      ]
    }
  ]
