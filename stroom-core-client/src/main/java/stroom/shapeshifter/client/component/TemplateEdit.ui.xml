<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:lay="urn:import:stroom.widget.layout.client"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:tickbox="urn:import:stroom.widget.tickbox.client"
             xmlns:ss="urn:import:stroom.shapeshifter.client.component"
             xmlns:b="urn:import:stroom.widget.button.client"
             xmlns:l="urn:import:stroom.widget.selection.client">
    <!-- A template's settings other than its name, shown under its title while the title is
         being edited (the owner, 2026-11-18). The name is the title's own field. A draft, as a
         card's is: OK, or Enter in the name, takes it and Cancel or Escape leaves the template
         as it was. -->
    <g:FlowPanel ui:field="form" styleName="template-edit">
        <form:FormGroup addStyleNames="template-edit__group template-edit__group--wide" identity="shapeshifterTemplateColour" label="Colour"
                        helpText="The template's swatch in the panel and the trace. Auto takes the palette by position.">
            <ss:ColourPalette ui:field="colour"/>
        </form:FormGroup>
        <form:FormGroup addStyleNames="template-edit__group" identity="shapeshifterTemplateMode" label="Mode"
                        helpText="The mode this template is dispatched in, or the root. Order within a mode is dispatch priority. A mode is added with + mode in the panel.">
            <l:SelectionBox ui:field="mode" addStyleNames="w-100"/>
        </form:FormGroup>
        <form:FormGroup addStyleNames="template-edit__group" identity="shapeshifterTemplateEncoding" label="Encoding"
                        helpText="This template's encoding where it differs from what encloses it; inherit takes the enclosing one.">
            <l:SelectionBox ui:field="encoding" addStyleNames="w-100"/>
        </form:FormGroup>
        <form:FormGroup addStyleNames="template-edit__group" identity="shapeshifterTemplateIgnoreErrors" label="Ignore errors"
                        helpText="Errors raised while this template runs are reported and do not stop the run.">
            <tickbox:TickBox ui:field="ignoreErrors"/>
        </form:FormGroup>
        <form:FormGroup addStyleNames="template-edit__group template-edit__group--wide" identity="shapeshifterTemplateParams" label="Params"
                        helpText="Parameters a call-template or apply-templates can pass, one per line as name, or name = default.">
            <form:TextArea ui:field="params" addStyleNames="w-100 edit-form__entries template-edit__params" visibleLines="2"/>
        </form:FormGroup>
        <g:FlowPanel styleName="template-edit__actions">
            <b:LinkButton ui:field="ok" addStyleNames="template-edit__action" text="OK" title="Take the name and these settings (Enter in the name)"/>
            <b:LinkButton ui:field="cancel" addStyleNames="template-edit__action" text="Cancel" title="Leave the template as it was (Escape)"/>
        </g:FlowPanel>
    </g:FlowPanel>
</ui:UiBinder>
