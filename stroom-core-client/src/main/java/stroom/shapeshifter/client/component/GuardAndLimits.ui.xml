<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:t="urn:import:stroom.widget.text.client"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client"
             xmlns:ss="urn:import:stroom.shapeshifter.client.component">
    <split:ScrollPane addStyleNames="max scroll-region"
                      focusable="true" role="region" ariaLabel="Guard and limits">
        <g:FlowPanel styleName="workbench-form__right">
            <g:FlowPanel styleName="workbench-form__section">
                <t:Html styleName="workbench-form__heading">Guard <span class="workbench-form__heading-note">(evaluated before matching, against the names in scope)</span></t:Html>
                <ss:ClauseListPanel ui:field="clauses"/>
                <t:Label ui:field="error" styleName="workbench-form__error"/>
            </g:FlowPanel>
            <g:FlowPanel styleName="workbench-form__section">
                <t:Label styleName="workbench-form__heading" text="Limits"/>
                <g:FlowPanel styleName="edit-form__step-row">
                    <t:Label styleName="edit-form__limit-label" text="Min"/>
                    <form:TextBox ui:field="min" styleName="edit-form__input edit-form__limit-input" ariaLabel="Match at least"/>
                    <t:Label styleName="edit-form__description" text="fewer matches than this is reported (a message, not a failure)"/>
                </g:FlowPanel>
                <g:FlowPanel styleName="edit-form__step-row">
                    <t:Label styleName="edit-form__limit-label" text="Max"/>
                    <form:TextBox ui:field="max" styleName="edit-form__input edit-form__limit-input" ariaLabel="Match at most"/>
                    <t:Label styleName="edit-form__description" text="stop matching this template after N matches"/>
                </g:FlowPanel>
                <g:FlowPanel styleName="edit-form__step-row">
                    <t:Label styleName="edit-form__limit-label" text="Only"/>
                    <form:TextBox ui:field="only" styleName="edit-form__input edit-form__limit-input" ariaLabel="Match only"/>
                    <t:Label styleName="edit-form__description" text="process only these matches, 1-based, comma-separated"/>
                </g:FlowPanel>
            </g:FlowPanel>
        </g:FlowPanel>
    </split:ScrollPane>
</ui:UiBinder>
