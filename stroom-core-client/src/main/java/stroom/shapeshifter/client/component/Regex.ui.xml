<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:t="urn:import:stroom.widget.text.client"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:split="urn:import:stroom.widget.layout.client"
             xmlns:tickbox="urn:import:stroom.widget.tickbox.client">
    <split:ScrollPane addStyleNames="max scroll-region"
                      focusable="true" role="region" ariaLabel="Regular expression">
        <g:FlowPanel styleName="workbench-form__right">
            <g:FlowPanel styleName="workbench-form__section">
                <t:Label styleName="workbench-form__heading" text="Pattern"/>
                <form:TextArea ui:field="pattern" ariaLabel="Pattern" styleName="workbench-form__pattern" visibleLines="2"/>
                <t:Html ui:field="patternMap" styleName="regex__pattern-map"
                        title="The pattern, group spans coloured — click a group to isolate it"/>
                <t:Label ui:field="error" styleName="workbench-form__error"/>
                <g:FlowPanel styleName="regex__row">
                    <t:Label ui:field="explode" styleName="add-button" text="explode into the tree ›"
                             title="Rewrite this regex as the pattern tree it is: meaning preserved, text not"/>
                    <tickbox:TickBox ui:field="dotAll" label="dot-all"/>
                    <tickbox:TickBox ui:field="caseInsensitive" label="case-insensitive"/>
                    <t:Label styleName="edit-form__limit-label" text="advance"/>
                    <form:TextBox ui:field="advance" styleName="edit-form__input edit-form__limit-input"
                               title="Bytes to step past after a match that consumed nothing; 0 lets the engine decide"/>
                </g:FlowPanel>
            </g:FlowPanel>
            <g:FlowPanel styleName="workbench-form__section">
                <t:Html styleName="workbench-form__heading">Groups <span class="workbench-form__heading-note">(a name beside a group declares it and captures the group into it; blank captures nothing)</span></t:Html>
                <t:Label ui:field="noGroups" styleName="placeholder" text="(no capturing groups)"/>
                <g:FlowPanel ui:field="groups" styleName="regex__groups"/>
            </g:FlowPanel>
            <g:FlowPanel styleName="workbench-form__section">
                <t:Label styleName="workbench-form__heading" text="How it runs"/>
                <t:Label ui:field="explain" styleName="workbench-form__lint workbench-form__explain"/>
            </g:FlowPanel>
        </g:FlowPanel>
    </split:ScrollPane>
</ui:UiBinder>
