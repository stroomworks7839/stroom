<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:t="urn:import:stroom.widget.text.client"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <g:FlowPanel styleName="body-card__outer">
        <g:FocusPanel ui:field="head" styleName="body-card__card">
            <g:FlowPanel styleName="body-card__line">
                <t:Label ui:field="grip" styleName="body-card__grip" text="⠿" title="Drag to move this instruction"/>
                <t:Label ui:field="swatch" styleName="swatch swatch--small"/>
                <t:Label ui:field="kind" styleName="body-card__kind"/>
                <t:Label ui:field="summary" styleName="body-card__literal"/>
                <t:Label ui:field="note" styleName="body-card__note"/>
                <g:FlowPanel ui:field="actions" styleName="body-card__actions">
                    <t:Label ui:field="up" styleName="item-action" text="↑" title="Move up"/>
                    <t:Label ui:field="down" styleName="item-action" text="↓" title="Move down"/>
                    <t:Label ui:field="addAfter" styleName="item-action" text="+" title="Add an instruction after this one"/>
                    <t:Label ui:field="remove" styleName="item-action item-action--delete" text="✕" title="Remove"/>
                </g:FlowPanel>
            </g:FlowPanel>
        </g:FocusPanel>
        <g:FlowPanel ui:field="branches"/>
    </g:FlowPanel>
</ui:UiBinder>
