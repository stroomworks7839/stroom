<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:t="urn:import:stroom.widget.text.client"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <g:FlowPanel styleName="ss-card-outer">
        <g:FocusPanel ui:field="head" styleName="ss-card">
            <g:FlowPanel styleName="ss-card-line">
                <t:Label ui:field="grip" styleName="ss-grip" text="⠿" title="Drag to move this instruction"/>
                <t:Label ui:field="swatch" styleName="ss-swatch ss-swatch--small"/>
                <t:Label ui:field="kind" styleName="ss-card-kind"/>
                <t:Label ui:field="summary" styleName="ss-card-lit"/>
                <t:Label ui:field="note" styleName="ss-card-note"/>
                <g:FlowPanel ui:field="actions" styleName="ss-card-actions">
                    <t:Label ui:field="up" styleName="ss-act" text="↑" title="Move up"/>
                    <t:Label ui:field="down" styleName="ss-act" text="↓" title="Move down"/>
                    <t:Label ui:field="addAfter" styleName="ss-act" text="+" title="Add an instruction after this one"/>
                    <t:Label ui:field="remove" styleName="ss-act ss-act--del" text="✕" title="Remove"/>
                </g:FlowPanel>
            </g:FlowPanel>
        </g:FocusPanel>
        <g:FlowPanel ui:field="branches" styleName="ss-branches"/>
    </g:FlowPanel>
</ui:UiBinder>
