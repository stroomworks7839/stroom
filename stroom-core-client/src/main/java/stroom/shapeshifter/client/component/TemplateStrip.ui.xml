<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:t="urn:import:stroom.widget.text.client"
             xmlns:split="urn:import:stroom.widget.layout.client"
             xmlns:l="urn:import:stroom.widget.selection.client"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:btn="urn:import:stroom.widget.button.client"
             xmlns:ss="urn:import:stroom.shapeshifter.client.component">
    <!-- The heading, and the template itself under it: one scrolled area holding the match, the
         guard, the names it defines and the body. The declarations and the captures were a
         strip of two grids under this, 170px whether or not they held anything; they are
         sections of the template now, a line each when empty (the owner, 2026-11-18). -->
    <split:SplitPane vertical="true" thin="true"
                     sizes="30px, *" minSizes="30px, 110px"
                     names="Heading, Template"
                     addStyleNames="max default-min-sizes template-strip">
        <g:FlowPanel styleName="template-strip__head">
            <t:Label ui:field="title" styleName="design-panel__title template-strip__pattern-title"/>
            <t:Label ui:field="chip" styleName="chip chip--editable"
                     title="Edit the name and settings"/>
            <!-- The name, edited where it reads: a template's or a mode's (the owner,
                 2026-11-18). There is no dialog for it and no field in the list. -->
            <ss:NameEdit ui:field="name"/>
            <t:Label ui:field="mode" styleName="template-strip__mode"/>
            <t:Label ui:field="note" styleName="template-strip__note"/>
        </g:FlowPanel>
        <!-- Named and marked as a region: with the document shown the match, role and guard rows
             are hidden, so nothing in here takes the focus and the pane makes itself the tab stop
             that scrolling it with the keys needs. -->
        <split:ScrollPane addStyleNames="max scroll-region" role="region" ariaLabel="Template">
            <g:FlowPanel styleName="template-strip__body">
                <!-- A template's settings other than its name, while its title is being
                     edited. A slot: they are made when the title is opened. -->
                <g:SimplePanel ui:field="settings" styleName="template-strip__settings" visible="false"/>
                <!-- How a mode is dispatched, when it is a mode that is shown (design 47 C):
                     the strategy its dispatch sites share, set here on all of them; and, while
                     nothing dispatches into it, the way to make the document do so. -->
                <g:FlowPanel ui:field="dispatchLine" styleName="template-strip__line" visible="false">
                    <t:Label styleName="key-label" text="Dispatch"/>
                    <l:SelectionBox ui:field="dispatch" ariaLabel="How the mode is dispatched" addStyleNames="template-strip__role"
                                    title="How templates in this mode are chosen where it is dispatched. Set here, it is set on every apply-templates that dispatches into the mode."/>
                    <t:Label ui:field="dispatchNote" styleName="edit-form__description template-strip__role-note"/>
                    <btn:LinkButton ui:field="dispatchLink" addStyleNames="add-button template-strip__dispatch-link" text="dispatch from the document"
                                    title="Point the document's apply-templates at this mode"/>
                </g:FlowPanel>
                <!-- A mode's templates, when it is a mode that is shown. -->
                <ss:DefinitionList ui:field="templates" heading="Templates" kind="template" visible="false"/>
                <g:FlowPanel ui:field="matchLine" styleName="template-strip__line">
                    <t:Label styleName="key-label" text="Match"/>
                    <!-- What the template matches, in a box the size of a field. At rest it
                         reads; clicked, a regex or a delimiter is its kind and its fields in the
                         same box, taken with Enter (design 47 B and G). The workbench is beside
                         it for everything else, and is the way in for a match with no one-line
                         spelling. -->
                    <g:FlowPanel styleName="template-strip__match-chip">
                        <t:Label ui:field="matchKind" styleName="template-strip__match-kind"/>
                        <g:FocusPanel ui:field="matchChip" styleName="template-strip__match-open">
                            <t:Label ui:field="matchSummary" styleName="template-strip__match-pattern"/>
                        </g:FocusPanel>
                        <!-- The match, open: its kind, then that kind's fields. Both kinds'
                             fields are here, and the kind decides which are shown. -->
                        <g:FlowPanel ui:field="matchEditor" styleName="template-strip__match-editor" visible="false">
                            <l:SelectionBox ui:field="matchKindBox" ariaLabel="Kind of match"
                                            addStyleNames="template-strip__match-kind-box"
                                            title="A regex or a delimiter is written here; every other kind in the workbench"/>
                            <form:TextBox ui:field="matchField" addStyleNames="template-strip__match-field"
                                          ariaLabel="Match pattern"/>
                            <g:FlowPanel ui:field="delimiterFields" styleName="template-strip__match-delimiter">
                                <form:TextBox ui:field="delimiterField"
                                              addStyleNames="template-strip__match-field template-strip__match-split"
                                              ariaLabel="Split on"
                                              title="The separator: \n \t \r and \\ spell the control characters"/>
                                <t:Label styleName="template-strip__match-word" text="container"/>
                                <form:TextBox ui:field="containerStartField"
                                              addStyleNames="template-strip__match-field template-strip__match-container"
                                              ariaLabel="Container start"
                                              title="What opens a container, inside which the separator is literal"/>
                                <t:Label styleName="template-strip__match-word" text="to"/>
                                <form:TextBox ui:field="containerEndField"
                                              addStyleNames="template-strip__match-field template-strip__match-container"
                                              ariaLabel="Container end" title="What closes a container"/>
                            </g:FlowPanel>
                        </g:FlowPanel>
                        <btn:LinkButton ui:field="workbench" addStyleNames="template-strip__match-workbench"
                                        text="workbench"
                                        title="Open the pattern workbench — editing, validation, groups, the plan"/>
                    </g:FlowPanel>
                </g:FlowPanel>
                <!-- Why the regex being typed does not compile, as the engine says it, while the
                     line is open (design 47 §7.2, finding 14). -->
                <t:Label ui:field="matchError" styleName="template-strip__match-error" visible="false"/>
                <!-- Between the match and the body, because that is where it acts: the match
                     is found either way, and skipping decides what becomes of it (design 44 §5d). -->
                <g:FlowPanel ui:field="roleLine" styleName="template-strip__line">
                    <t:Label styleName="key-label" text="Match is"/>
                    <l:SelectionBox ui:field="role" ariaLabel="What the match is for" addStyleNames="template-strip__role"
                                    title="What this match is for. Both roles advance the cursor and run the body; only a record counts, captures and opens a frame to step."/>
                    <t:Label ui:field="roleNote" styleName="edit-form__description template-strip__role-note"/>
                </g:FlowPanel>
                <!-- Guard and limits off the match row, so the match can have the width
                     (design 44 §5h). -->
                <g:FlowPanel ui:field="guardLine" styleName="template-strip__line">
                    <t:Label styleName="key-label" text="Guard"/>
                    <t:Label ui:field="guardLimits" styleName="placeholder template-strip--clickable"
                             title="Guard and limits — edited in the workbench"/>
                </g:FlowPanel>
                <!-- The names the template defines, before the body that uses them: what it
                     declares, and what its match binds. -->
                <ss:DefinitionList ui:field="declarations" heading="Declarations" kind="declaration"/>
                <ss:DefinitionList ui:field="captures" heading="Captures" kind="capture"/>
                <g:SimplePanel ui:field="content" styleName="template-strip__content"/>
            </g:FlowPanel>
        </split:ScrollPane>
    </split:SplitPane>
</ui:UiBinder>
