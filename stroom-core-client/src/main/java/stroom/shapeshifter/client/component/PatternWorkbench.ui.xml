<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:t="urn:import:stroom.widget.text.client"
             xmlns:split="urn:import:stroom.widget.layout.client"
             xmlns:b="urn:import:stroom.widget.button.client">
    <split:SplitPane ui:field="layout" vertical="true" thin="true" sizes="34px, *, 210px"
                     names="Title, Workbench, Guard and limits"
                     addStyleNames="max default-min-sizes ss-wb">
        <g:FlowPanel styleName="ss-wb-title">
            <t:Label text="Pattern workbench —"/>
            <t:Label ui:field="subject" styleName="mono"/>
            <t:Label styleName="ss-spacer"/>
            <b:Toolbar name="Actions" ui:field="buttons"/>
        </g:FlowPanel>
        <split:SplitPane thin="true" sizes="420px, *" names="Sample, Editor"
                         addStyleNames="max default-min-sizes">
            <g:SimplePanel ui:field="sample" styleName="max"/>
            <g:SimplePanel ui:field="editor" styleName="max"/>
        </split:SplitPane>
        <g:SimplePanel ui:field="guardAndLimits" styleName="max"/>
    </split:SplitPane>
</ui:UiBinder>
