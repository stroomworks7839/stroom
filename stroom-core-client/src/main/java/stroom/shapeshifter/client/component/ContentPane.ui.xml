<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:t="urn:import:stroom.widget.text.client"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <g:FlowPanel styleName="max design-panel content-pane">
        <g:FlowPanel ui:field="reader" styleName="max content-pane__reader">
            <t:Label ui:field="note" styleName="content-pane__note"/>
            <g:ScrollPanel styleName="design-panel__body">
                <g:FlowPanel>
                    <t:Html ui:field="content" styleName="content-box mono"/>
                    <g:FlowPanel ui:field="loose" styleName="content-pane__loose-list"/>
                </g:FlowPanel>
            </g:ScrollPanel>
        </g:FlowPanel>
        <t:Label ui:field="empty" styleName="placeholder"/>
    </g:FlowPanel>
</ui:UiBinder>
