<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:t="urn:import:stroom.widget.text.client"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:l="urn:import:stroom.widget.layout.client">
    <!-- No title of its own: the pane it is shown in names it, and folds it away
         (CollapsiblePane, design 47 E). -->
    <g:FlowPanel styleName="max design-panel variables-pane">
        <l:ScrollPane addStyleNames="design-panel__body">
            <g:FlowPanel>
                <t:Label ui:field="empty" styleName="placeholder"/>
                <g:FlowPanel ui:field="body"/>
            </g:FlowPanel>
        </l:ScrollPane>
    </g:FlowPanel>
</ui:UiBinder>
