<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:t="urn:import:stroom.widget.text.client"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <g:FocusPanel ui:field="row" styleName="template-row">
        <g:FlowPanel>
            <g:FlowPanel styleName="template-row__line">
                <t:Label ui:field="chip" styleName="chip"/>
                <t:Label ui:field="name" styleName="template-row__name"/>
                <t:Label ui:field="flag" styleName="template-row__flag"/>
                <t:Label ui:field="count" styleName="template-row__count"/>
                <t:Label ui:field="limit" styleName="template-row__limit"/>
            </g:FlowPanel>
            <g:FlowPanel ui:field="heat" styleName="template-row__heat">
                <t:Label ui:field="heatBar" styleName="template-row__heat-bar"/>
            </g:FlowPanel>
        </g:FlowPanel>
    </g:FocusPanel>
</ui:UiBinder>
