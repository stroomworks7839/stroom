<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:t="urn:import:stroom.widget.text.client"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <g:FlowPanel styleName="max design-panel output-pane">
        <t:Label ui:field="note" styleName="content-pane__note"/>
        <g:ScrollPanel ui:field="body" styleName="design-panel__body">
            <g:FlowPanel>
                <t:Label ui:field="empty" styleName="placeholder"/>
                <t:Html ui:field="output" styleName="output-pane__box mono"/>
            </g:FlowPanel>
        </g:ScrollPanel>
    </g:FlowPanel>
</ui:UiBinder>
