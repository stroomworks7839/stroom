<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:lay="urn:import:stroom.widget.layout.client"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:tickbox="urn:import:stroom.widget.tickbox.client"
             xmlns:l="urn:import:stroom.widget.selection.client">
    <lay:ScrollPane addStyleNames="max">
        <g:FlowPanel styleName="form-padding form">
            <form:FormGroup identity="shapeshifterPartKind" label="Kind"
                            helpText="pattern matches a tree at the cursor; take consumes a length; seek moves the cursor by a length, or to an offset; read casts the bytes at the cursor.">
                <l:SelectionBox ui:field="kind" addStyleNames="w-100"/>
            </form:FormGroup>
            <form:FormGroup ui:field="patternGroup" identity="shapeshifterPartPattern" label="Pattern tree"
                            helpText="The pattern node in its wire form, as the tree tab holds it.">
                <form:TextArea ui:field="pattern" addStyleNames="w-100 edit-form__entries" visibleLines="8"/>
            </form:FormGroup>
            <form:FormGroup ui:field="lengthGroup" identity="shapeshifterPartLength" label="Length"
                            helpText="A count of bytes, or the value a label or a variable holds.">
                <g:FlowPanel styleName="edit-form__step-row">
                    <!-- Two controls under one label: each is named for itself, or neither a screen
                         reader nor a test can tell them apart (design 46 §6.5). -->
                    <l:SelectionBox ui:field="lengthKind" addStyleNames="clause-row__operator" ariaLabel="Length from"/>
                    <form:TextBox ui:field="length" styleName="edit-form__input clause-row__value" ariaLabel="Length value"/>
                </g:FlowPanel>
            </form:FormGroup>
            <form:FormGroup ui:field="absoluteGroup" identity="shapeshifterPartAbsolute" label="Absolute"
                            helpText="Seek to this offset from the start of the match, rather than by this many bytes.">
                <tickbox:TickBox ui:field="absolute"/>
            </form:FormGroup>
            <form:FormGroup ui:field="castGroup" identity="shapeshifterPartCast" label="As"
                            helpText="What the bytes at the cursor mean; the read consumes the cast's width.">
                <l:SelectionBox ui:field="cast" addStyleNames="w-100"/>
            </form:FormGroup>
            <form:FormGroup ui:field="labelGroup" identity="shapeshifterPartLabel" label="Label"
                            helpText="Names what this part took or read, for a capture to bind. Blank for none.">
                <form:TextBox ui:field="label" addStyleNames="w-100"/>
            </form:FormGroup>
        </g:FlowPanel>
    </lay:ScrollPane>
</ui:UiBinder>
