<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:dg="urn:import:stroom.widget.datagrid.client"
             xmlns:t="urn:import:stroom.widget.text.client"
             xmlns:split="urn:import:stroom.widget.layout.client"
             xmlns:ss="urn:import:stroom.shapeshifter.client.component">
    <!-- Design 43 section 4.1: the mockup's quadrant - panel, then (crumb / input | variables)
         over (strip | output) - as nested split panels. The workbench and the sample page each
         replace the whole quadrant, leaving only the panel beside them (design 44 §5a, §5p).
         One axis per split pane, so what GWT's docking panel did in one, this does in two. -->
    <split:SplitPane ui:field="layout" vertical="true" thin="true" sizes="26px, *, 110px"
                     names="Banner, Design, Messages"
                     addStyleNames="max default-min-sizes shapeshifter-design">
        <t:Label ui:field="banner" styleName="shapeshifter-design__banner"/>
        <split:SplitPane thin="true" sizes="220px, *" names="Templates, Design"
                         addStyleNames="max default-min-sizes">
            <ss:TemplatePanel ui:field="templatePanel"/>
            <!-- Everything right of the panel: the navigator's rows, or what is shown in their
                 place - the sample page, or the workbench (design 44 §5a, §5p). -->
            <g:SimplePanel ui:field="centre" styleName="max">
                <split:SplitPane ui:field="rows" vertical="true" thin="true" sizes="300px, *"
                                 names="Input, Output" addStyleNames="max default-min-sizes">
                    <!-- 32px: a toolbar button is 24px and its toolbar pads 4px either side for
                         the focus ring, and the crumb's stepper is a toolbar. -->
                    <split:SplitPane vertical="true" thin="true" sizes="32px, *"
                                     names="Crumb, Input" addStyleNames="max default-min-sizes">
                        <ss:Breadcrumb ui:field="crumb"/>
                        <split:SplitPane thin="true" sizes="*, 320px" names="Input, Variables"
                                         addStyleNames="max default-min-sizes">
                            <ss:ContentPane ui:field="input"/>
                            <ss:VariablesPane ui:field="variables"/>
                        </split:SplitPane>
                    </split:SplitPane>
                    <split:SplitPane thin="true" sizes="*, 320px"
                                     names="Strip, Output" addStyleNames="max default-min-sizes">
                        <ss:TemplateStrip ui:field="strip"/>
                        <ss:OutputPane ui:field="output"/>
                    </split:SplitPane>
                </split:SplitPane>
            </g:SimplePanel>
        </split:SplitPane>
        <dg:PagerPanel ui:field="messages" addStyleNames="max"/>
    </split:SplitPane>
</ui:UiBinder>
