<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:t="urn:import:stroom.widget.text.client"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:lay="urn:import:stroom.widget.layout.client"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:tickbox="urn:import:stroom.widget.tickbox.client"
             xmlns:l="urn:import:stroom.widget.selection.client"
             xmlns:ss="urn:import:stroom.shapeshifter.client.component">
    <lay:ScrollPane addStyleNames="max">
        <!-- form-padding, so the form is inset from the edges of the strip as its controls are:
             without it a form takes layout-helpers.css's focus-ring room instead, which pads
             7px and pulls the same back with a negative margin, leaving it flush. -->
        <g:FlowPanel styleName="form form-padding dock-container-vertical source-settings">
            <t:Label styleName="source-settings__title" text="Source — the document"/>
            <t:Label ui:field="error" styleName="source-settings__error"/>
            <form:FormGroup identity="shapeshifterProjectName" label="Project name">
                <form:TextBox ui:field="name" addStyleNames="w-100"/>
            </form:FormGroup>
            <form:FormGroup identity="shapeshifterEncoding" label="Encoding"
                            helpText="auto sniffs the byte-order mark once before compiling and takes UTF-8 without one. A byte-order mark contradicting a declared encoding is a run message.">
                <l:SelectionBox ui:field="encoding"/>
            </form:FormGroup>
            <form:FormGroup identity="shapeshifterIgnoreErrors" label="Ignore errors">
                <tickbox:TickBox ui:field="ignoreErrors"/>
            </form:FormGroup>
            <form:FormGroup identity="shapeshifterBufferSize" label="Buffer size"
                            helpText="Bytes read ahead when a match can span reads.">
                <form:TextBox ui:field="bufferSize"/>
            </form:FormGroup>
            <!-- The rest is for compatibility and limits, and a new project needs none of it:
                 folded under one heading until asked for, or until it holds a choice that changes
                 what the project does (design 48 C3). The buffer size stays out: a sample of
                 large records needs it, rung 6 sets it, and folding it cost that rung a click. -->
            <ss:DisclosureButton ui:field="advancedToggle" text="Advanced"
                                 note="version, dispatch, max sequence entries, strict values"/>
            <g:FlowPanel ui:field="advanced" styleName="source-settings__advanced" visible="false">
                <form:FormGroup identity="shapeshifterProjectVersion" label="Version"
                                helpText="The format version the project is written to. From version 5 a substring start counts from 1.">
                    <form:TextBox ui:field="version"/>
                </form:FormGroup>
                <form:FormGroup identity="shapeshifterDispatch" label="Dispatch"
                                helpText="How templates are chosen among the candidates in a mode. Blank is strict.">
                    <l:SelectionBox ui:field="dispatch"/>
                </form:FormGroup>
                <form:FormGroup identity="shapeshifterMaxSequenceEntries" label="Max sequence entries"
                                helpText="The most entries a list, map or set declaration holds.">
                    <form:TextBox ui:field="maxSequenceEntries"/>
                </form:FormGroup>
                <form:FormGroup identity="shapeshifterStrictValues" label="Strict values"
                                helpText="A cast that fails is an error rather than an empty value.">
                    <tickbox:TickBox ui:field="strictValues"/>
                </form:FormGroup>
            </g:FlowPanel>
        </g:FlowPanel>
    </lay:ScrollPane>
</ui:UiBinder>
