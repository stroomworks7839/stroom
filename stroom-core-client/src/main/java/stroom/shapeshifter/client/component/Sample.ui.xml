<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:t="urn:import:stroom.widget.text.client"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:split="urn:import:stroom.widget.layout.client">
    <split:SplitPane vertical="true" thin="true" sizes="160px, *" names="Sample, Matches"
                     addStyleNames="max default-min-sizes ss-smp">
        <g:FlowPanel styleName="max ss-smp-in">
            <t:Html styleName="ss-wb-h4">Sample <span class="ss-wb-h4-note">(the cursor's frame to start with; edit freely — this never runs the document)</span></t:Html>
            <form:TextArea ui:field="sample" styleName="ss-smp-text mono"
                           ariaLabel="Sample text to match against"/>
        </g:FlowPanel>
        <!-- The matches table scrolls when there are many, so the keyboard can
             reach it: a named region that takes the focus -->
        <split:ScrollPane addStyleNames="max scroll-region"
                          focusable="true" role="region" ariaLabel="Matches">
            <g:FlowPanel styleName="ss-smp-out">
                <t:Label ui:field="summary" styleName="ss-wb-h4"/>
                <t:Html ui:field="matches" styleName="ss-content-box ss-smp-matches mono"/>
                <t:Html ui:field="table"/>
                <t:Label ui:field="nothing" styleName="ss-none"/>
            </g:FlowPanel>
        </split:ScrollPane>
    </split:SplitPane>
</ui:UiBinder>
