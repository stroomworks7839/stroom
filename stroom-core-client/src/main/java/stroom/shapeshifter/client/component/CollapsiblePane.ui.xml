<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:btn="urn:import:stroom.widget.button.client">
    <g:FlowPanel ui:field="root" styleName="max collapsible-pane">
        <!-- The title is the button: the whole bar folds the pane away, and a button is what the
             keyboard and a screen reader expect to find doing it. -->
        <g:FlowPanel styleName="collapsible-pane__head">
            <btn:LinkButton ui:field="toggle" addStyleNames="collapsible-pane__toggle"/>
        </g:FlowPanel>
        <g:SimplePanel ui:field="content" styleName="collapsible-pane__content"/>
    </g:FlowPanel>
</ui:UiBinder>
