<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:l="urn:import:stroom.item.client">
    <g:ThinSplitLayoutPanel ui:field="layout" styleName="max default-min-sizes ss-strip">
        <g:north size="30">
            <g:FlowPanel styleName="ss-strip-head">
                <g:Label ui:field="title" styleName="ss-panel-title ss-strip-ptitle"/>
                <g:Label ui:field="chip" styleName="ss-chip ss-chip--editable" title="Edit the template's name, colour, mode, params and encoding…"/>
                <g:Label ui:field="name" styleName="ss-strip-name" title="Edit the template's name, colour, mode, params and encoding…"/>
                <g:Label ui:field="mode" styleName="ss-strip-mode"/>
                <g:Label ui:field="note" styleName="ss-strip-note"/>
            </g:FlowPanel>
        </g:north>
        <g:south size="170">
            <g:ThinSplitLayoutPanel ui:field="details" styleName="max default-min-sizes">
                <g:west size="360">
                    <g:SimplePanel ui:field="declarations" styleName="max"/>
                </g:west>
                <g:center>
                    <g:SimplePanel ui:field="captures" styleName="max"/>
                </g:center>
            </g:ThinSplitLayoutPanel>
        </g:south>
        <g:center>
            <g:ScrollPanel styleName="max">
                <g:FlowPanel styleName="ss-strip-body">
                    <g:FlowPanel ui:field="matchLine" styleName="ss-strip-line">
                        <g:Label styleName="ss-strip-k" text="match"/>
                        <g:FocusPanel ui:field="matchChip" styleName="ss-match-chip"
                                      title="Open the pattern workbench — editing, validation, groups, the plan">
                            <g:FlowPanel styleName="ss-match-chip-inner">
                                <g:Label ui:field="matchKind" styleName="ss-match-kind"/>
                                <g:Label ui:field="matchSummary" styleName="ss-match-pattern"/>
                                <g:Label styleName="ss-match-wb" text="✎ workbench"/>
                            </g:FlowPanel>
                        </g:FocusPanel>
                    </g:FlowPanel>
                    <!-- Between the match and the body, because that is where it acts: the match
                         is found either way, and skipping decides what becomes of it (design 44 §5d). -->
                    <g:FlowPanel ui:field="roleLine" styleName="ss-strip-line">
                        <g:Label styleName="ss-strip-k" text="match is"/>
                        <l:SelectionBox ui:field="role" addStyleNames="ss-strip-role"
                                        title="What this match is for. Both roles advance the cursor and run the body; only a record counts, captures and opens a frame to step."/>
                        <g:Label ui:field="roleNote" styleName="ss-det-desc ss-role-note"/>
                    </g:FlowPanel>
                    <!-- Guard and limits off the match row, so the match can have the width
                         (design 44 §5h). -->
                    <g:FlowPanel ui:field="guardLine" styleName="ss-strip-line">
                        <g:Label styleName="ss-strip-k" text="guard"/>
                        <g:Label ui:field="guardLimits" styleName="ss-none ss-clickable"
                                 title="Guard and limits — edited in the workbench"/>
                    </g:FlowPanel>
                    <g:SimplePanel ui:field="content" styleName="ss-strip-content"/>
                </g:FlowPanel>
            </g:ScrollPanel>
        </g:center>
    </g:ThinSplitLayoutPanel>
</ui:UiBinder>
