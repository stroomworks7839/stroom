<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:tickbox="urn:import:stroom.widget.tickbox.client.view">
    <g:FlowPanel styleName="max form-padding form">
        <form:FormGroup identity="learnerFilterDocument"
                        label="Document"
                        helpText="Which Shapeshifter AI document's pipelines. Left empty, every document you may read.">
            <g:SimplePanel ui:field="document" width="400px"/>
        </form:FormGroup>
        <form:FormGroup identity="learnerFilterStates"
                        label="State"
                        helpText="Where a pipeline's learner stands. None ticked — or all of them — is every state.">
            <g:FlowPanel ui:field="states" styleName="dock-container-vertical"/>
        </form:FormGroup>
        <form:FormGroup identity="learnerFilterShowDeletedPipelines"
                        helpText="A deleted pipeline's learning is kept to be read until it ages out. Left unticked, it is not shown.">
            <tickbox:CustomCheckBox ui:field="showDeletedPipelines" label="Show deleted pipelines"/>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
