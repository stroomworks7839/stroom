<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:l="urn:import:stroom.item.client"
             xmlns:form="urn:import:stroom.widget.form.client">
    <g:FlowPanel styleName="max form-padding form">
        <form:FormGroup identity="builtInTextChoice"
                        label="Built-in text"
                        helpText="The built-in texts whose variables this text may use. Loading one replaces this document's own words for this text; where it is this text's own built-in, the document goes back to following the built-in.">
            <l:SelectionBox ui:field="choice"/>
        </form:FormGroup>
        <form:FormGroup identity="builtInTextPreview"
                        label="Text">
            <g:TextArea ui:field="preview" width="100%" height="300px" styleName="templateText"/>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
