<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <g:FocusPanel ui:field="row" styleName="ss-tpl-row">
        <g:FlowPanel styleName="ss-tpl-line">
            <g:Label ui:field="chip" styleName="ss-chip"/>
            <g:Label ui:field="name" styleName="ss-tpl-name mono"/>
            <g:Label ui:field="count" styleName="ss-tpl-count"/>
        </g:FlowPanel>
    </g:FocusPanel>
</ui:UiBinder>
