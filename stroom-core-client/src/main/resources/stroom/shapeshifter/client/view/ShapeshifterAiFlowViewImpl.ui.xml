<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:l="urn:import:stroom.item.client"
             xmlns:b="urn:import:stroom.widget.button.client">
    <g:FlowPanel styleName="max form-padding form">
        <form:FormGroup identity="shapeshifterAiFlowChart"
                        label="Learning flow"
                        helpText="The questions the stage asks the model, drawn as a flow: a step is a question of one kind — Chain, Split, Target, Configure or Admit — and the decision after it is the judging of a candidate. Solid connectors are transitions the flow declares; dashed ones are what happens by default: a pass goes down to the next step, a shortfall re-asks the step with its next candidate, spent candidates leave by the step's exit. P parks the session for a person; G gives the shape up and errors its streams. Click a step to edit it beside the chart, a solid connector to select that transition, or Start for the texts every question shares. A step painted red names a problem; hover it to read which.">
            <g:FlowPanel>
                <g:FlowPanel styleName="flow-editor dashboard-panel">
                    <g:SimplePanel ui:field="chartPanel" styleName="flow-editor-chart"/>
                    <g:FlowPanel styleName="flow-editor-side">
                        <g:FlowPanel styleName="flow-toolbar">
                            <b:Button ui:field="addStep" text="Add step" addStyleNames="allow-focus"/>
                            <b:Button ui:field="copyStep" text="Copy" addStyleNames="allow-focus"/>
                            <b:Button ui:field="deleteStep" text="Delete" addStyleNames="allow-focus"/>
                            <b:Button ui:field="moveUp" text="Up" addStyleNames="allow-focus"/>
                            <b:Button ui:field="moveDown" text="Down" addStyleNames="allow-focus"/>
                            <b:Button ui:field="loadExample" text="Load an example" addStyleNames="allow-focus"/>
                        </g:FlowPanel>
                        <g:Label ui:field="stepHeading" styleName="flow-heading"/>
                        <g:Label ui:field="stepProblem" styleName="flow-problem" visible="false"/>
                        <g:Label ui:field="nodeNote" styleName="flow-note"/>
                        <g:SimplePanel ui:field="stepForm"/>
                        <g:Label ui:field="stepDefaults" styleName="flow-note"/>
                        <g:FlowPanel ui:field="textSection">
                            <g:Label text="Question text" styleName="flow-heading"/>
                            <l:SelectionBox ui:field="template"/>
                            <g:TextArea ui:field="templateText" width="100%" height="200px" styleName="templateText"/>
                            <b:Button ui:field="resetTemplate" text="Use built-in" width="120px" addStyleNames="allow-focus"/>
                            <g:Label ui:field="templateStatus" styleName="flow-note"/>
                        </g:FlowPanel>
                    </g:FlowPanel>
                </g:FlowPanel>
                <g:Label ui:field="flowProblem" styleName="flow-problem" visible="false"/>
            </g:FlowPanel>
        </form:FormGroup>
        <form:FormGroup identity="shapeshifterAiFlowText"
                        label="As text"
                        helpText="The same flow, one line per step, in the grammar import, export and the harness carry. Edit it and the chart follows; a line that does not parse is reported and nothing changes until it does.">
            <g:TextArea ui:field="flowText" width="100%" height="120px" styleName="flow-text"/>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
