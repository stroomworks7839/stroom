<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:tab="urn:import:stroom.widget.tab.client.view">
    <!-- Three levels, master to detail (design 06 A115): the learning pipelines; the selected pipeline's
         sessions, with its waiting streams on a second tab; and the selected session's turns beside its
         path over the flow. -->
    <g:SimplePanel styleName="max">
        <g:ThinSplitLayoutPanel styleName="max">
            <g:north size="300">
                <g:SimplePanel ui:field="learners" styleName="max dashboard-panel"/>
            </g:north>
            <g:center>
                <g:ThinSplitLayoutPanel styleName="max">
                    <g:north size="260">
                        <g:FlowPanel styleName="max dock-container-vertical dashboard-panel">
                            <g:FlowPanel styleName="dock-min">
                                <tab:LinkTabBar ui:field="tabBar" addStyleNames="max"/>
                            </g:FlowPanel>
                            <tab:LayerContainerImpl ui:field="layerContainer" styleName="dock-max"/>
                        </g:FlowPanel>
                    </g:north>
                    <g:center>
                        <g:ThinSplitLayoutPanel styleName="max">
                            <g:east size="440">
                                <g:SimplePanel ui:field="flow" styleName="max dashboard-panel"/>
                            </g:east>
                            <g:center>
                                <g:SimplePanel ui:field="turnList" styleName="max dashboard-panel"/>
                            </g:center>
                        </g:ThinSplitLayoutPanel>
                    </g:center>
                </g:ThinSplitLayoutPanel>
            </g:center>
        </g:ThinSplitLayoutPanel>
    </g:SimplePanel>
</ui:UiBinder>
