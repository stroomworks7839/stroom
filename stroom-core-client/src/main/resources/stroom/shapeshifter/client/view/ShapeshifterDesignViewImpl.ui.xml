<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui">
    <g:ThinSplitLayoutPanel ui:field="layout" styleName="max default-min-sizes shapeshifter-design">
        <g:north size="26">
            <g:Label ui:field="banner" styleName="shapeshifter-banner"/>
        </g:north>
        <g:south size="140">
            <g:SimplePanel ui:field="messages" styleName="max"/>
        </g:south>
        <g:west size="260">
            <g:SimplePanel ui:field="templatePanel" styleName="max"/>
        </g:west>
        <g:center>
            <g:SimplePanel ui:field="centre" styleName="max"/>
        </g:center>
    </g:ThinSplitLayoutPanel>
</ui:UiBinder>
