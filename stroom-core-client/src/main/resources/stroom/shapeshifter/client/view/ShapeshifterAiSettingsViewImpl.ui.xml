<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:l="urn:import:stroom.item.client"
             xmlns:v="urn:import:stroom.widget.valuespinner.client">
    <g:FlowPanel styleName="max form-padding form">
        <form:FormGroup identity="shapeshifterAiLearningMode"
                        label="Learning mode"
                        helpText="Whether the stage may call the model at all. Disabled by default; Shapeshifter AI is opt-in per document. Disabled still selects among the variants already bound.">
            <l:SelectionBox ui:field="learningMode"/>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
