<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:l="urn:import:stroom.item.client">
    <g:FlowPanel styleName="ss-step-row">
        <g:Label ui:field="joiner" styleName="ss-num-s"/>
        <g:TextBox ui:field="by" styleName="ss-edit-in ss-clause-var"
                   title="What to sort each entry by: a declared name, $1 for a capture group, or a call such as get(m, &quot;k&quot;)"/>
        <l:SelectionBox ui:field="order" addStyleNames="ss-clause-op" title="Which way this key runs"/>
        <l:SelectionBox ui:field="as" addStyleNames="ss-clause-as" title="How the key is read before ordering"/>
        <g:Label ui:field="remove" styleName="ss-act ss-act--del" text="✕" title="Remove this sort key"/>
    </g:FlowPanel>
</ui:UiBinder>
