<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:b="urn:import:stroom.widget.button.client">
    <g:ThinSplitLayoutPanel styleName="max default-min-sizes shapeshifter-structure">
        <g:west size="420">
            <g:FlowPanel styleName="max dock-container-vertical">
                <b:ButtonPanel ui:field="buttonPanel" addStyleNames="dock-min"/>
                <g:ScrollPanel styleName="dock-max">
                    <g:FlowPanel styleName="shapeshifter-structure-pane">
                        <g:FlowPanel styleName="shapeshifter-regex-row">
                            <g:Label styleName="shapeshifter-kind" text="as regex"/>
                            <g:Label ui:field="regex" styleName="shapeshifter-pattern-text"/>
                        </g:FlowPanel>
                        <g:Label ui:field="error" styleName="shapeshifter-error"/>
                        <g:HTML ui:field="tree"/>
                        <g:Label styleName="shapeshifter-kind shapeshifter-library-title" text="standard library"/>
                        <g:HTML ui:field="library"/>
                    </g:FlowPanel>
                </g:ScrollPanel>
            </g:FlowPanel>
        </g:west>
        <g:center>
            <g:SimplePanel ui:field="editor" styleName="max"/>
        </g:center>
    </g:ThinSplitLayoutPanel>
</ui:UiBinder>
