<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:l="urn:import:stroom.item.client"
             xmlns:form="urn:import:stroom.widget.form.client">
    <g:FlowPanel styleName="max form-padding form">
        <form:FormGroup identity="transitionOutcome"
                        label="On"
                        helpText="The outcome this fires on. A transition on an outcome fires at once, on the first candidate that has it.">
            <l:SelectionBox ui:field="outcome"/>
        </form:FormGroup>
        <form:FormGroup identity="transitionTarget"
                        label="Go to"
                        helpText="The step to go to. 'end' completes the plan; 'abandon' gives the attempt up.">
            <l:SelectionBox ui:field="target"/>
        </form:FormGroup>
    </g:FlowPanel>
</ui:UiBinder>
