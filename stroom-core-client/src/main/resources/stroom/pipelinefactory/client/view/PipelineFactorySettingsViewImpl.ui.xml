<!DOCTYPE ui:UiBinder SYSTEM "http://dl.google.com/gwt/DTD/xhtml.ent">
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
             xmlns:g="urn:import:com.google.gwt.user.client.ui"
             xmlns:form="urn:import:stroom.widget.form.client"
             xmlns:tickbox="urn:import:stroom.widget.tickbox.client.view">
    <g:SimplePanel styleName="max">
        <g:ThinSplitLayoutPanel styleName="max">
            <g:west size="460">
                <g:ScrollPanel styleName="max">
                    <g:FlowPanel styleName="form-padding form">
                        <g:Label ui:field="problems" addStyleNames="error"/>
                        <form:FormGroup identity="pipelineFactoryEnabled"
                                        label="Enabled"
                                        helpText="Whether the Pipeline Factory job runs this factory. A factory may be saved incomplete while it is not enabled.">
                            <tickbox:CustomCheckBox ui:field="enabled"/>
                        </form:FormGroup>
                        <form:FormGroup identity="pipelineFactoryKey"
                                        label="One pipeline per"
                                        helpText="The fields one combination of whose values is one pipeline. Only the fields a processor filter can sort streams by are offered.">
                            <g:FlowPanel>
                                <tickbox:CustomCheckBox ui:field="keyFeed" label="Feed"/>
                                <tickbox:CustomCheckBox ui:field="keyType" label="Type"/>
                                <tickbox:CustomCheckBox ui:field="keyPipeline" label="Pipeline that wrote the stream"/>
                            </g:FlowPanel>
                        </form:FormGroup>
                        <form:FormGroup identity="pipelineFactoryTemplate"
                                        label="Template"
                                        helpText="The pipeline every made pipeline inherits. A change to it reaches every pipeline made from it.">
                            <g:SimplePanel ui:field="template" addStyleNames="w-100"/>
                        </form:FormGroup>
                        <form:FormGroup identity="pipelineFactoryFolderPattern"
                                        label="Folder"
                                        helpText="Where a made pipeline goes, as a path from the root of the explorer, e.g. Feeds/${{feed}.">
                            <g:TextBox ui:field="folderPattern" addStyleNames="w-100"/>
                        </form:FormGroup>
                        <form:FormGroup identity="pipelineFactoryNamePattern"
                                        label="Name"
                                        helpText="What a made pipeline is called, e.g. ${{feed} ${{type}.">
                            <g:TextBox ui:field="namePattern" addStyleNames="w-100"/>
                        </form:FormGroup>
                        <form:FormGroup identity="pipelineFactoryRunAsUser"
                                        label="Run as user"
                                        helpText="Who the factory makes its folders, pipelines and filters as, and who the filters it makes run as. It makes only what this user may make.">
                            <g:SimplePanel ui:field="runAsUser"/>
                        </form:FormGroup>
                        <g:Label text="Changes apply to what the factory makes next. What it has already made is left as it is."
                                 addStyleNames="form-padding"/>
                    </g:FlowPanel>
                </g:ScrollPanel>
            </g:west>
            <g:center>
                <g:ThinSplitLayoutPanel styleName="max">
                    <g:north size="260">
                        <g:FlowPanel styleName="max form-padding form">
                            <form:FormGroup identity="pipelineFactoryStreamFilter"
                                            label="Streams looked at"
                                            helpText="Which streams the factory looks at for combinations it has not met. Every filter it makes takes this and the combination's values. A new factory reads every stream already held that matches, so add a Create Time term to look only at recent streams; the filters it makes then process only those too."
                                            addStyleNames="dock-max">
                                <g:SimplePanel ui:field="streamFilter" styleName="max default-min-sizes"/>
                            </form:FormGroup>
                        </g:FlowPanel>
                    </g:north>
                    <g:center>
                        <g:SimplePanel ui:field="properties" styleName="max dashboard-panel dock-container-vertical"/>
                    </g:center>
                </g:ThinSplitLayoutPanel>
            </g:center>
        </g:ThinSplitLayoutPanel>
    </g:SimplePanel>
</ui:UiBinder>
